# Copy to .env.docker before deploying outside a local machine.
MYSTERY_ATLAS_WEB_PORT=3100
MYSTERY_ATLAS_POSTGRES_PASSWORD=replace-with-a-long-database-password
MYSTERY_ATLAS_SESSION_SECRET=replace-with-at-least-32-random-characters
MYSTERY_ATLAS_MINIO_ROOT_USER=mystery_atlas
MYSTERY_ATLAS_MINIO_ROOT_PASSWORD=replace-with-a-long-object-storage-password

# Keep false until the deployment is placed behind HTTPS.
MYSTERY_ATLAS_SESSION_COOKIE_SECURE=false
MYSTERY_ATLAS_FIRST_USER_ADMIN=true

# Moonshot 中国站 Key 使用 https://api.moonshot.cn/v1；
# 国际站 Key 使用 https://api.moonshot.ai/v1。
MYSTERY_ATLAS_AI_BASE_URL=
MYSTERY_ATLAS_AI_API_KEY=
MYSTERY_ATLAS_AI_READING_MODEL=
MYSTERY_ATLAS_AI_TRUTH_MODEL=
MYSTERY_ATLAS_AI_MAX_CONCURRENCY=10
