# API
MYSTERY_ATLAS_ENVIRONMENT=development
MYSTERY_ATLAS_DATABASE_URL=sqlite:///./.data/mystery-atlas.db
MYSTERY_ATLAS_REDIS_URL=redis://localhost:6379/0
MYSTERY_ATLAS_CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
MYSTERY_ATLAS_SESSION_SECRET=replace-with-at-least-32-random-characters
MYSTERY_ATLAS_SESSION_TTL_HOURS=168
MYSTERY_ATLAS_SESSION_COOKIE_SECURE=false
MYSTERY_ATLAS_FIRST_USER_ADMIN=false
MYSTERY_ATLAS_UPLOAD_DIR=.data/uploads
MYSTERY_ATLAS_MAX_UPLOAD_MB=50

# Web
MYSTERY_ATLAS_API_ORIGIN=http://127.0.0.1:8010

# Private object storage
MYSTERY_ATLAS_S3_ENDPOINT=http://localhost:9000
MYSTERY_ATLAS_S3_ACCESS_KEY=mystery_atlas
MYSTERY_ATLAS_S3_SECRET_KEY=change-this-in-production
MYSTERY_ATLAS_S3_BUCKET=private-library

# AI provider adapter
MYSTERY_ATLAS_AI_PROVIDER=openai-compatible
# Moonshot 中国站 Key 使用 https://api.moonshot.cn/v1；
# 国际站 Key 使用 https://api.moonshot.ai/v1。
MYSTERY_ATLAS_AI_BASE_URL=
MYSTERY_ATLAS_AI_API_KEY=
MYSTERY_ATLAS_AI_READING_MODEL=
MYSTERY_ATLAS_AI_TRUTH_MODEL=
MYSTERY_ATLAS_AI_TIMEOUT_SECONDS=90
MYSTERY_ATLAS_AI_CONTENT_IDLE_TIMEOUT_SECONDS=180
MYSTERY_ATLAS_AI_MAX_CHUNK_CHARS=12000
MYSTERY_ATLAS_AI_CHUNK_OVERLAP_CHARS=500
MYSTERY_ATLAS_AI_CHAPTERS_PER_BATCH=6
MYSTERY_ATLAS_AI_MAX_CONCURRENCY=10
MYSTERY_ATLAS_AI_SYNTHESIS_BATCH_CHARS=40000
# inline starts an isolated local worker; use celery when a worker and Redis are running.
MYSTERY_ATLAS_ANALYSIS_EXECUTION=inline
